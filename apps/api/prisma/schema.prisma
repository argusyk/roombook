generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  admin
}

enum BookingKind {
  room          // бронювання аудиторії
  consultation  // запис студента на слот консультації
}

enum ReminderKind {
  h1            // нагадування за 1 год до початку (розд. 13)
}

model User {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  name      String
  role      Role               @default(student)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  bookings  Booking[]
  series    BookingSeries[]
  slots     ConsultationSlot[] @relation("SlotTeacher")
}

model Room {
  id           Int                @id @default(autoincrement())
  code         String             @unique   // "A-314"
  name         String                       // назва українською, для звітів
  building     String                       // "Корпус A"
  capacity     Int
  hasProjector Boolean            @default(false)
  bookings     Booking[]
  series       BookingSeries[]
  slots        ConsultationSlot[]
}

model ConsultationSlot {
  id        Int       @id @default(autoincrement())
  teacher   User      @relation("SlotTeacher", fields: [teacherId], references: [id])
  teacherId Int
  room      Room?     @relation(fields: [roomId], references: [id])
  roomId    Int?                              // аудиторія необов'язкова
  startsAt  DateTime  @db.Timestamptz(3)
  endsAt    DateTime  @db.Timestamptz(3)
  seats     Int       @default(1)             // скільки студентів можуть записатися
  note      String?
  bookings  Booking[]
  reminders ReminderLog[]

  @@index([startsAt])
}

model Booking {
  id          Int               @id @default(autoincrement())
  kind        BookingKind       @default(room)
  room        Room?             @relation(fields: [roomId], references: [id])
  roomId      Int?                            // для kind = room
  slot        ConsultationSlot? @relation(fields: [slotId], references: [id])
  slotId      Int?                            // для kind = consultation
  user        User              @relation(fields: [userId], references: [id])
  userId      Int
  series      BookingSeries?    @relation(fields: [seriesId], references: [id])
  seriesId    Int?                            // розд. 4
  startsAt    DateTime          @db.Timestamptz(3)   // зберігається в UTC
  endsAt      DateTime          @db.Timestamptz(3)
  purpose     String                          // вільний текст від користувача
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  cancelledAt DateTime?         @db.Timestamptz(3)   // скасування; NULL = активне

  @@index([roomId, startsAt])                 // розд. 13, PR #208

  // CHECK booking_kind_target, booking_interval – міграція init (вручну);
  // EXCLUDE booking_no_overlap (roomId =, tstzrange [) &&, WHERE cancelledAt IS NULL) –
  // міграція 20261104090000_booking_no_overlap (розд. 12). Не прибирати.
}

model BookingSeries {
  id             Int       @id @default(autoincrement())
  room           Room      @relation(fields: [roomId], references: [id])
  roomId         Int
  user           User      @relation(fields: [userId], references: [id])
  userId         Int
  startLocal     String    // "2027-02-02T14:00", місцевий час timeZone
  durationMin    Int
  intervalWeeks  Int       @default(1)
  untilLocalDate String    // "2027-05-25", включно
  exdates        String[]  // ["2027-04-13"]
  timeZone       String    @default("Europe/Kyiv")
  purpose        String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  bookings       Booking[]
}

model ReminderLog {                                              // розд. 13, PR #207
  id     Int              @id @default(autoincrement())
  slot   ConsultationSlot @relation(fields: [slotId], references: [id])
  slotId Int
  kind   ReminderKind
  sentAt DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([slotId, kind])
}
