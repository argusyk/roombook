# apps/api/.env – скопіюйте цей файл у .env (Prisma читає саме його).
# Секретів тут немає: значення для локальної бази розробника.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://roombook:roombook@localhost:5432/roombook
# Тижневий звіт (розд. 11): legacy | shadow | new; адреса старих PHP-звітів для legacy/shadow
REPORTS_ROOM_WEEK_MODE=new
# LEGACY_REPORTS_URL=http://reports.example.local/
# Інтеграційні тести (test:int) самі беруть базу <ім'я>_test (тут roombook_test)
# і застосовують до неї міграції; база створюється docker-compose (pnpm db:up).
