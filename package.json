{
  "name": "roombook",
  "private": true,
  "type": "module",
  "description": "RoomBook – сервіс бронювання аудиторій і консультацій кафедри (навчальний приклад)",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @roombook/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
